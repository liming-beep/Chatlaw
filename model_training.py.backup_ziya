"""
ChatLaw RAG模型实现
使用chatlaw-text2vec做检索 + LLaMA做生成
适配T4 GPU（16GB显存）
"""

import torch
import json
from transformers import AutoTokenizer, AutoModel, AutoModelForCausalLM
from sentence_transformers import SentenceTransformer
import faiss
import numpy as np
from tqdm import tqdm
import matplotlib.pyplot as plt
import matplotlib
matplotlib.rcParams['font.sans-serif'] = ['SimHei']
matplotlib.rcParams['axes.unicode_minus'] = False

class LegalRAGModel:
    def __init__(self, 
                 embedding_model_path='chatlaw-text2vec',
                 llm_model_path='ziya-LLaMA-13b-v1.1',
                 device='cuda' if torch.cuda.is_available() else 'cpu'):
        
        self.device = device
        print(f"🖥️  使用设备: {self.device}")
        
        # 1. 加载嵌入模型（用于检索）
        print("📥 加载嵌入模型...")
        self.embedder = SentenceTransformer(embedding_model_path)
        self.embedder.to(device)
        
        # 2. 加载LLM（用于生成）- 使用量化减少显存
        print("📥 加载语言模型（量化以适配T4）...")
        self.tokenizer = AutoTokenizer.from_pretrained(
            llm_model_path,
            trust_remote_code=True
        )
        
        # 关键：使用8bit量化，T4可以跑13B模型
        self.llm = AutoModelForCausalLM.from_pretrained(
            llm_model_path,
            load_in_8bit=True,  # 8bit量化
            device_map='auto',
            trust_remote_code=True,
            torch_dtype=torch.float16
        )
        
        self.knowledge_base = []
        self.index = None
        
    # ===== 构建知识库 =====
    def build_knowledge_base(self, data_path='train_data.jsonl'):
        """
        从训练数据构建向量知识库
        """
        print("🔨 构建知识库...")
        
        # 读取数据
        with open(data_path, 'r', encoding='utf-8') as f:
            data = [json.loads(line) for line in f]
        
        self.knowledge_base = data
        questions = [item['question'] for item in data]
        
        # 生成向量
        print("🧮 生成问题向量...")
        embeddings = self.embedder.encode(
            questions,
            show_progress_bar=True,
            batch_size=32
        )
        
        # 构建Faiss索引（快速检索）
        print("📚 构建Faiss索引...")
        dimension = embeddings.shape[1]
        self.index = faiss.IndexFlatIP(dimension)  # 内积相似度
        
        # 归一化后添加
        faiss.normalize_L2(embeddings)
        self.index.add(embeddings.astype('float32'))
        
        print(f"✅ 知识库构建完成: {len(self.knowledge_base)}条法律知识")
        
        # 保存索引
        faiss.write_index(self.index, 'legal_knowledge.index')
        print("💾 索引已保存到 legal_knowledge.index")
    
    # ===== 检索相关知识 =====
    def retrieve(self, query, top_k=3):
        """
        检索最相关的法律知识
        """
        # 查询向量化
        query_vec = self.embedder.encode([query])
        faiss.normalize_L2(query_vec)
        
        # 检索
        distances, indices = self.index.search(query_vec.astype('float32'), top_k)
        
        # 返回检索结果
        results = []
        for idx, score in zip(indices[0], distances[0]):
            if idx < len(self.knowledge_base):
                results.append({
                    'question': self.knowledge_base[idx]['question'],
                    'answer': self.knowledge_base[idx]['answer'],
                    'score': float(score)
                })
        return results
    
    # ===== 生成答案 =====
    def generate_answer(self, query, retrieved_docs):
        """
        基于检索结果生成答案
        """
        # 构建上下文提示词
        context = "\n\n".join([
            f"参考{i+1}：\n问：{doc['question']}\n答：{doc['answer']}" 
            for i, doc in enumerate(retrieved_docs)
        ])
        
        prompt = f"""你是一个专业的法律助手。请基于以下参考资料回答用户问题。

参考资料：
{context}

用户问题：{query}

请给出专业、准确的回答："""

        # 生成（控制生成长度以节省显存）
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
        
        with torch.no_grad():
            outputs = self.llm.generate(
                **inputs,
                max_new_tokens=512,
                temperature=0.7,
                top_p=0.9,
                do_sample=True
            )
        
        answer = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        # 提取生成部分
        answer = answer.split("请给出专业、准确的回答：")[-1].strip()
        
        return answer
    
    # ===== 端到端推理 =====
    def answer_question(self, query):
        """
        完整的RAG流程：检索 + 生成
        """
        # 1. 检索
        print(f"🔍 检索相关知识...")
        retrieved = self.retrieve(query, top_k=3)
        
        # 2. 生成
        print(f"💭 生成答案...")
        answer = self.generate_answer(query, retrieved)
        
        return {
            'question': query,
            'answer': answer,
            'references': retrieved
        }
    
    # ===== 模型评估 =====
    def evaluate(self, test_data_path='test_data.jsonl'):
        """
        在测试集上评估模型性能
        """
        print("📊 开始评估模型...")
        
        # 读取测试数据
        with open(test_data_path, 'r', encoding='utf-8') as f:
            test_data = [json.loads(line) for line in f]
        
        results = {
            'retrieval_accuracy': [],  # 检索准确率
            'answer_quality': [],      # 答案质量（人工标注或自动评估）
            'response_time': []        # 响应时间
        }
        
        import time
        
        for item in tqdm(test_data[:50], desc="评估进度"):  # 评估50个样本
            query = item['question']
            ground_truth = item['answer']
            
            # 计时
            start = time.time()
            
            # 检索
            retrieved = self.retrieve(query, top_k=5)
            
            # 检查检索准确率（是否检索到相关内容）
            retrieval_correct = any(
                self._is_similar(doc['answer'], ground_truth) 
                for doc in retrieved
            )
            results['retrieval_accuracy'].append(1 if retrieval_correct else 0)
            
            # 生成答案（可选，耗时较长）
            # answer = self.generate_answer(query, retrieved[:3])
            
            end = time.time()
            results['response_time'].append(end - start)
        
        # 统计结果
        metrics = {
            '检索准确率': np.mean(results['retrieval_accuracy']) * 100,
            '平均响应时间(秒)': np.mean(results['response_time']),
        }
        
        print("\n" + "="*50)
        print("📈 评估结果")
        print("="*50)
        for k, v in metrics.items():
            print(f"{k}: {v:.2f}")
        
        # 保存结果
        self.plot_evaluation_results(results)
        
        return metrics
    
    def _is_similar(self, text1, text2, threshold=0.3):
        """简单的文本相似度判断"""
        # 使用关键词重叠作为简单度量
        words1 = set(text1)
        words2 = set(text2)
        intersection = len(words1 & words2)
        union = len(words1 | words2)
        return (intersection / union) > threshold if union > 0 else False
    
    def plot_evaluation_results(self, results):
        """绘制评估结果图表"""
        fig, axes = plt.subplots(1, 2, figsize=(12, 4))
        
        # 检索准确率
        accuracy = np.mean(results['retrieval_accuracy']) * 100
        axes[0].bar(['检索准确率'], [accuracy], color='steelblue')
        axes[0].set_ylabel('准确率 (%)')
        axes[0].set_ylim(0, 100)
        axes[0].set_title('检索性能')
        axes[0].text(0, accuracy+5, f'{accuracy:.1f}%', ha='center', fontsize=12)
        
        # 响应时间分布
        axes[1].hist(results['response_time'], bins=20, color='coral', edgecolor='black')
        axes[1].set_xlabel('响应时间 (秒)')
        axes[1].set_ylabel('频次')
        axes[1].set_title('响应时间分布')
        axes[1].axvline(np.mean(results['response_time']), 
                       color='red', linestyle='--', 
                       label=f'平均: {np.mean(results["response_time"]):.2f}s')
        axes[1].legend()
        
        plt.tight_layout()
        plt.savefig('model_evaluation.png', dpi=300, bbox_inches='tight')
        print("✅ 评估图表已保存: model_evaluation.png")


# ===== 使用示例 =====
if __name__ == "__main__":
    # 初始化模型
    model = LegalRAGModel(
    embedding_model_path="/workspace/models/ChatLaw-Text2Vec",
    llm_model_path="/workspace/models/Ziya-LLaMA-13B-v1.1"
)

    
    # 构建知识库
    model.build_knowledge_base('train_data.jsonl')
    
    # 测试问答
    test_query = "如何起诉离婚？"
    result = model.answer_question(test_query)
    
    print("\n" + "="*50)
    print("💬 问答测试")
    print("="*50)
    print(f"问题：{result['question']}")
    print(f"\n答案：{result['answer']}")
    print(f"\n参考来源：")
    for i, ref in enumerate(result['references']):
        print(f"{i+1}. {ref['question']} (相似度: {ref['score']:.3f})")
    
    # 评估模型
    metrics = model.evaluate('test_data.jsonl')
    
    print("\n✨ 模型训练和评估完成！")
